<?xml version="1.0" encoding="utf-8"?>
<!--
  Voiceon backup rules for Android 12+ (API 31+)
  Backs up: database, shared preferences
  Excludes: audio recordings (too large, re-imported on next sync)
-->
<full-backup-content>
  <!-- Back up the SQLite database -->
  <include domain="database" path="voiceon.sqlite" />

  <!-- Back up all shared preferences -->
  <include domain="sharedpref" path="." />
</full-backup-content>