<?xml version="1.0" encoding="utf-8"?>
<!--
  Voiceon data extraction rules for Android 12+ (API 31+)
  Used for both cloud backup (Auto Backup) and device-to-device transfers (D2D).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="voiceon.sqlite" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="voiceon.sqlite" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>